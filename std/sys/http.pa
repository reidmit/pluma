# A small HTTP/1.1 server, built entirely on `std/sys/net`. You write a
# handler -- a function from a `request` to a `response` -- and `serve`
# runs it, accepting connections and replying to each one.
#
#     def handler = fun req {
#         task.ok (http.text 200 "hello from pluma")
#     }
#     def main = fun { http.serve "127.0.0.1:8080" handler }
#
# The handler returns a `task`, so it can `try` other async work (a
# database call, another service) before replying. Errors a handler runs
# into are its own to handle -- it always returns a `response`, even if
# that response is a 500.
#
# This is plain text over TCP, so put it behind a reverse proxy
# (nginx, Caddy, your platform's load balancer) for TLS. Connections are
# served concurrently -- each runs in its own task, so a slow handler
# (a database call, a downstream request) never blocks the others.
#
# It speaks HTTP/1.1 with keep-alive: a connection serves requests in turn
# (framed by Content-Length, including pipelined ones) until the client sends
# `Connection: close` or hangs up. Chunked transfer, HTTP/2, and WebSockets are
# not handled yet.

use std/bytes
use std/compress
use std/dict
use std/hex
use std/list
use std/stream
use std/string
use std/task
use std/sys/net
use std/sys/process

# The HTTP method (verb). `other` carries any method name not listed
# here, so unusual verbs still parse.
public enum method {
	get
	post
	put
	delete
	patch
	head
	options
	other string
}

# An incoming request. `path` is the part before any `?`; `query` is the
# raw text after it (e.g. `"a=1&b=2"`). Header names are lower-cased so
# lookups don't depend on the sender's capitalization.
public alias request {
	method :: method,
	path :: string,
	query :: string,
	headers :: dict string string,
	body :: bytes,
}

# A reply. `status` is the numeric code (200, 404, ...); `body` is raw
# bytes. `Content-Length` and `Connection` are added for you when the
# response is sent, so you don't set them here.
#
# `stream-body` is `none` for an ordinary fixed reply. A streaming reply
# (`stream-response`) carries `some s` instead: the server writes `s`'s
# elements as a series of SSE-style events and closes the connection at the
# end, so `body`/`Content-Length` are ignored. One stream per connection --
# like the rest of this module, the socket closes when the reply is done.
#
# `hijack` is `none` for an ordinary reply. `some take-over` instead hands the
# raw connection to `take-over` *in place of* sending this response -- a
# protocol upgrade (e.g. `ws.upgrade` switching to WebSocket). The handler that
# returns it owns the connection from there; the server writes nothing itself
# and closes once `take-over` returns. `status`/`headers`/`body` are then unused.
public alias response {
	status :: int,
	headers :: dict string string,
	body :: bytes,
	stream-body :: option (stream bytes),
	hijack :: option (fun net.connection -> task nothing _),
}

# --- building responses --------------------------------------------------

# A plain-text response with the given status code and body.
#
#     http.text 200 "hello"
#     http.text 404 "nope"
public def text :: fun int string -> response = fun status body {
	{
		status,
		headers: dict.from-entries [("content-type", "text/plain; charset=utf-8")],
		body: string.to-bytes body,
		stream-body: none,
		hijack: none,
	}
}

# An HTML response with the given status code and body -- e.g. a server-side
# rendered page (`view.to-string (page ())` wrapped in a document shell).
#
#     http.html 200 (ui.document ())
public def html :: fun int string -> response = fun status body {
	{
		status,
		headers: dict.from-entries [("content-type", "text/html; charset=utf-8")],
		body: string.to-bytes body,
		stream-body: none,
		hijack: none,
	}
}

# A 404 Not Found, ready to return from a handler.
#
#     http.not-found ()
public def not-found :: fun nothing -> response = fun {
	text 404 "Not Found"
}

# A redirect to `location`. Use 301 for a permanently moved URL, 302 for a
# temporary one.
#
#     http.redirect 301 "/docs/reference"
public def redirect :: fun int string -> response = fun status location {
	{
		status,
		headers: dict.from-entries [("location", location)],
		body: string.to-bytes "",
		stream-body: none,
		hijack: none,
	}
}

# A streaming response: the server writes each element of `events` as it is
# pulled, then closes the connection. `events` is a `stream bytes` -- each
# element is one message's payload bytes, framed as an SSE `next` event on the
# wire (see `fetch-stream` for the reader). Use it for server->client
# subscriptions; the RPC layer builds one of these for a `stream R` endpoint.
#
#     http.stream-response 200 (dict.from-entries [("content-type", "text/event-stream")]) events
public def stream-response :: fun int (dict string string) (stream bytes) -> response = fun status headers events {
	{status, headers, body: string.to-bytes "", stream-body: some events, hijack: none}
}

# --- the server ----------------------------------------------------------

# Binds to `address` (like `"127.0.0.1:8080"`) and serves `handler`
# forever. `err`s as a failed task if the address can't be bound.
#
#     http.serve "0.0.0.0:8080" handler
#
# If the `PORT` environment variable is set, its value replaces the port in
# `address` (the host is kept). This is the platform convention -- a host like
# Cloud Run, Heroku, or Render hands your server a port via `$PORT` -- and it's
# what lets `pluma dev` place the server subprocess on a free port without you
# hardcoding one to match. With `PORT` unset, `address` is used verbatim.
public def serve :: fun string (fun request -> task response _) -> task nothing _ = fun address handler {
	when net.listen (with-port-from-env address) is ok server {
		serve-on server handler
	} is err e {
		task.err ("http.serve: " ++ e)
	}
}

# Like `serve`, but terminates TLS -- this serves `https`. `cert` and `key` are
# PEM text (the certificate chain and its private key); see `net.listen-tls`.
# Requests reach `handler` already decrypted, and responses are encrypted on the
# way out, so a handler written for `serve` works here unchanged. `err`s as a
# failed task if the address can't be bound or the cert/key don't load.
#
#     http.serve-tls "0.0.0.0:443" cert-pem key-pem handler
public def serve-tls :: fun string string string (fun request -> task response _) -> task nothing _ = fun address cert key handler {
	when net.listen-tls (with-port-from-env address) cert key is ok server {
		serve-on server handler
	} is err e {
		task.err ("http.serve-tls: " ++ e)
	}
}

# `address` with its port replaced by `$PORT` when that variable is set, else
# `address` unchanged. See `serve` for why.
def with-port-from-env :: fun string -> string = fun address {
	when process.env "PORT" is some port {
		host-part address ++ ":" ++ port
	} is none {
		address
	}
}

# The host portion of a `host:port` address: everything up to the last colon, so
# `127.0.0.1:8080` keeps `127.0.0.1`. (v1 assumes an IPv4/host:port form.)
def host-part :: fun string -> string = fun address {
	let segs = string.split address ":"
	string.join (list.take segs (list.length segs - 1)) ":"
}

# Serves `handler` on a listener you've already opened. Useful when you
# need the bound address first (listen on port `0`, read `net.local-addr`,
# then serve).
#
# Connections are handled concurrently. The acceptor and every in-flight
# handler are children of one `manual scope`; the acceptor is itself a
# child, so a freshly accepted connection and a finished handler both
# surface through the same `s.next` drain. Draining is what keeps the
# server honest: each settled child is reaped as `serve-loop` pulls it, so
# completed handlers never pile up in the scope (the leak that kept the
# first cut sequential). At any moment the live set is the in-flight
# handlers plus the single waiting acceptor.
public def serve-on :: fun net.listener (fun request -> task response _) -> task nothing _ = fun server handler {
	manual scope as s {
		s.spawn (accept-one server)
		serve-loop s server handler
	}
}

# What a child of the serve scope settles to. `arrived` is the acceptor
# handing back a new connection; `served` is a handler reporting it has
# finished replying; `closed` is the acceptor saying the listener is gone,
# so we stop re-arming it. Both child kinds settle to this one type, which
# is what lets them share the homogeneous `manual scope`.
enum serve-event {
	arrived net.connection
	served
	closed
}

# The acceptor child: wait for one connection and tag the outcome.
def accept-one :: fun net.listener -> task serve-event _ = fun server {
	try c = task.attempt (net.accept server)
	when c is ok conn {
		task.ok (serve-event.arrived conn)
	} is err _ {
		task.ok serve-event.closed
	}
}

# A handler child: serve every request on one connection (HTTP/1.1 keep-alive),
# then report `served`. `handle-conn` never fails, so this child never fails the
# scope.
def handle-child :: fun net.connection (fun request -> task response _) -> task serve-event _ = fun conn handler {
	try handle-conn conn handler (string.to-bytes "")
	task.ok serve-event.served
}

# Drain the serve scope. Each settled child drives exactly one `s.next`, so
# completions are reaped as fast as they're produced: an `arrived`
# connection spawns its handler and re-arms the acceptor; a `served`
# handler was already reaped by this `s.next`, so we just continue; a
# `closed` listener (the scope was cancelled, or accept errored) stops the
# re-arm, and once the last in-flight handler drains, `s.next` yields
# `none` and the loop ends.
def serve-loop :: fun (manual-scope-handle serve-event) net.listener (fun request -> task response _) -> task nothing _ = fun s server handler {
	try got = s.next ()
	when got is none {
		task.ok ()
	} is some outcome {
		when outcome is ok ev {
			when ev is serve-event.arrived conn {
				s.spawn (handle-child conn handler)
				s.spawn (accept-one server)
				serve-loop s server handler
			} is serve-event.served {
				serve-loop s server handler
			} is serve-event.closed {
				serve-loop s server handler
			}
		} is err _ {
			serve-loop s server handler
		}
	}
}

# Read one request off `conn`, run the handler, write the response, close.
# Never fails the server: a read/parse problem just ends this connection.
# Serve requests on one connection in turn until the client signals close, sends
# no more, or a streaming response ends the connection. `leftover` carries bytes
# already read past the previous request — empty for a non-pipelining client, but
# a pipelined request buffered there is handled too, since `read-until-headers`
# returns at once when it already holds the header terminator and `parse-head`
# splits on the first one.
def handle-conn :: fun net.connection (fun request -> task response _) bytes -> task nothing _ = fun conn handler leftover {
	try raw-r = read-until-headers conn leftover
	when raw-r is ok raw {
		# No complete request head (the peer closed, or sent a partial) — done.
		if bytes.contains raw crlf2 {
			let parsed = parse-head raw
			try body-r = read-body-framed conn parsed.body-start parsed.content-length
			when body-r is ok bl {
				let (body, rest) = bl
				let req = {
					method: parsed.method,
					path: parsed.path,
					query: parsed.query,
					headers: parsed.headers,
					body,
				}
				try resp = handler req
				when resp.hijack is some take-over {
					# The handler upgraded this connection to another protocol (e.g. WebSocket)
					# and now owns the raw socket. Run it to completion, then close — we write
					# no HTTP response and don't keep this connection alive for more requests.
					try take-over conn
					finish conn
				} is none {
					when resp.stream-body is some events {
						# Streaming is framed by connection close — never keep-alive.
						try write-all conn (serialize-stream-head resp)
						try write-events conn events
						finish conn
					} is none {
						let alive = wants-keep-alive parsed.headers
						let encoded = compress-response parsed.headers resp
						try write-all conn (serialize encoded alive)
						if alive {
							handle-conn conn handler rest
						} else {
							finish conn
						}
					}
				}
			} is err _ {
				finish conn
			}
		} else {
			finish conn
		}
	} is err _ {
		finish conn
	}
}

# HTTP/1.1 keeps a connection alive by default; the client closes it only by
# sending `Connection: close`.
def wants-keep-alive :: fun (dict string string) -> bool = fun headers {
	when dict.lookup headers "connection" is some v {
		string.to-lower (string.trim v) != "close"
	} is none {
		true
	}
}

def finish :: fun net.connection -> task nothing _ = fun conn {
	net.close conn
	task.ok ()
}

# --- reading ------------------------------------------------------------

def crlf2 :: bytes = string.to-bytes "\r\n\r\n"

# Accumulate bytes until the blank line that ends the header block (or the
# peer closes). The leftover after the headers is the start of the body.
def read-until-headers :: fun net.connection bytes -> task (result bytes string) _ = fun conn acc {
	if bytes.contains acc crlf2 {
		task.ok (ok acc)
	} else {
		try r = task.attempt (net.read conn 4096)
		when r is ok chunk {
			if bytes.is-empty chunk {
				task.ok (ok acc)
			} else {
				read-until-headers conn (bytes.concat acc chunk)
			}
		} is err e {
			task.ok (err e)
		}
	}
}

# Like `read-body`, but also returns the bytes read past this request's body —
# the start of the next pipelined request (empty for a non-pipelining client).
# The server keep-alive loop threads that leftover into the next iteration.
def read-body-framed :: fun net.connection bytes int -> task (result (bytes, bytes) string) _ = fun conn acc need {
	if bytes.length acc >= need {
		task.ok (ok (bytes.slice acc 0 need, bytes.slice acc need (bytes.length acc)))
	} else {
		try r = task.attempt (net.read conn 4096)
		when r is ok chunk {
			if bytes.is-empty chunk {
				task.ok (ok (acc, string.to-bytes ""))
			} else {
				read-body-framed conn (bytes.concat acc chunk) need
			}
		} is err e {
			task.ok (err e)
		}
	}
}

# Read until the body has `need` bytes (or the peer closes), starting from
# whatever already arrived with the headers.
def read-body :: fun net.connection bytes int -> task (result bytes string) _ = fun conn acc need {
	if bytes.length acc >= need {
		task.ok (ok (bytes.slice acc 0 need))
	} else {
		try r = task.attempt (net.read conn 4096)
		when r is ok chunk {
			if bytes.is-empty chunk {
				task.ok (ok acc)
			} else {
				read-body conn (bytes.concat acc chunk) need
			}
		} is err e {
			task.ok (err e)
		}
	}
}

# --- parsing ------------------------------------------------------------

# The list element at `i`, or `fallback` if `i` is past the end.
def nth :: fun (list string) int string -> string = fun xs i fallback {
	if i < list.length xs {
		list.get xs i
	} else {
		fallback
	}
}

def parse-method :: fun string -> method = fun s {
	if s == "GET" {
		method.get
	} else if s == "POST" {
		method.post
	} else if s == "PUT" {
		method.put
	} else if s == "DELETE" {
		method.delete
	} else if s == "PATCH" {
		method.patch
	} else if s == "HEAD" {
		method.head
	} else if s == "OPTIONS" {
		method.options
	} else {
		method.other s
	}
}

# Collect one `Name: value` header line as a `(name, value)` pair, lower-casing
# the name. Splits on the first colon, so values containing `:` survive.
# Pairs accumulate in a plain list and are handed to `dict.from-entries` once,
# rather than rebuilding the persistent dict on every header -- a single
# transient build instead of N path-copies up the trie.
def parse-header :: fun (list (string, string)) string -> list (string, string) = fun acc line {
	let kv = string.split line ":"
	if list.length kv >= 2 {
		let key = string.to-lower (string.trim (list.head kv ?? ""))
		let value = string.trim (string.join (list.drop kv 1) ":")
		list.push acc (key, value)
		acc
	} else {
		acc
	}
}

# Split the raw bytes at the header/body boundary and parse the request
# line + headers. Returns everything `handle-one` needs, including how many
# more body bytes to read and whatever body bytes already arrived.
def parse-head :: fun bytes -> {
	method :: method,
	path :: string,
	query :: string,
	headers :: dict string string,
	content-length :: int,
	body-start :: bytes,
} = fun raw {
	let parts = bytes.split raw crlf2
	let head = list.head parts ?? string.to-bytes ""
	let body-start = bytes.join (list.drop parts 1) crlf2
	let header-str = bytes.to-string head ?? ""
	let lines = string.split header-str "\r\n"
	let request-line = list.head lines ?? ""
	let rl = string.split request-line " "
	let m = parse-method (string.to-upper (list.head rl ?? "GET"))
	let target = nth rl 1 "/"
	let tq = string.split target "?"
	let path = list.head tq ?? "/"
	let query = nth tq 1 ""
	let headers = dict.from-entries (list.fold (list.drop lines 1) [] parse-header)
	let clen = when dict.lookup headers "content-length" is some v {
		string.to-int v ?? 0
	} is none {
		0
	}
	{method: m, path, query, headers, content-length: clen, body-start}
}

# --- writing ------------------------------------------------------------

# Write every byte of `data`, looping until the connection has taken it all
# (one `write` can accept fewer bytes than offered).
def write-all :: fun net.connection bytes -> task (result int string) _ = fun conn data {
	if bytes.is-empty data {
		task.ok (ok 0)
	} else {
		try w = task.attempt (net.write conn data)
		when w is ok n {
			if n >= bytes.length data {
				task.ok (ok n)
			} else {
				write-all conn (bytes.slice data n (bytes.length data))
			}
		} is err e {
			task.ok (err e)
		}
	}
}

# Render a response as HTTP/1.1 bytes: status line, the handler's headers, the
# computed Content-Length, the Connection header (keep-alive or close), a blank
# line, then body. The Content-Length lets a keep-alive client frame the reply.
def serialize :: fun response bool -> bytes = fun resp keep-alive {
	let status-line = "HTTP/1.1 " ++ to-string resp.status ++ " " ++ status-text resp.status ++ "\r\n"
	let header-lines = string.join (list.map (dict.entries resp.headers) render-header) ""
	let length-line = "Content-Length: " ++ to-string (bytes.length resp.body) ++ "\r\n"
	let conn-line = if keep-alive {
		"Connection: keep-alive\r\n"
	} else {
		"Connection: close\r\n"
	}
	let head = status-line ++ header-lines ++ length-line ++ conn-line ++ "\r\n"
	bytes.concat (string.to-bytes head) resp.body
}

# --- response compression ----------------------------------------------------

# Bodies smaller than this aren't worth compressing (gzip/brotli framing overhead
# can exceed the savings, and the CPU isn't free).
def compress-min :: int = 256

# Compress `resp`'s body when the client (`req-headers`) accepts an encoding and
# the response is a good candidate -- big enough, a text-like content-type, and
# not already encoded -- adding the matching `Content-Encoding` header (`serialize`
# then derives the compressed `Content-Length`) plus `Vary: Accept-Encoding` so a
# shared cache keys on the request's encoding. Otherwise the response is returned
# unchanged. Streaming responses never reach here.
def compress-response :: fun (dict string string) response -> response = fun req-headers resp {
	when chosen-encoding req-headers resp is some enc {
		{
			...resp,
			body: encode-with enc resp.body,
			headers: dict.insert (dict.insert resp.headers "content-encoding" enc) "vary" "Accept-Encoding",
		}
	} is none {
		resp
	}
}

# The encoding to use for this response, or none. Prefers brotli (smaller) over
# gzip when the client lists both.
def chosen-encoding :: fun (dict string string) response -> option string = fun req-headers resp {
	if bytes.length resp.body >= compress-min {
		if dict.contains-key resp.headers "content-encoding" {
			none
		} else if compressible-type resp.headers {
			accepted-encoding (dict.lookup req-headers "accept-encoding" ?? "")
		} else {
			none
		}
	} else {
		none
	}
}

# Pick the client's preferred supported encoding from an `Accept-Encoding` value.
def accepted-encoding :: fun string -> option string = fun accept {
	let lower = string.to-lower accept
	if string.contains lower "br" {
		some "br"
	} else if string.contains lower "gzip" {
		some "gzip"
	} else {
		none
	}
}

# Whether the response's content-type is worth compressing -- text and the
# text-based application types. Binary types (images, fonts, already-zipped) and
# an absent content-type are left alone.
def compressible-type :: fun (dict string string) -> bool = fun headers {
	when dict.lookup headers "content-type" is some ct {
		is-text-type (string.to-lower ct)
	} is none {
		false
	}
}

def is-text-type :: fun string -> bool = fun ct {
	string.contains ct "text/" or string.contains ct "json" or string.contains ct "javascript" or string.contains ct "xml" or string.contains ct "svg" or string.contains ct "html" or string.contains ct "css"
}

def encode-with :: fun string bytes -> bytes = fun enc body {
	if enc == "br" {
		compress.brotli body
	} else {
		compress.gzip body
	}
}

# --- streaming a response ----------------------------------------------------

# The head of a streaming response: status line, the handler's headers, and
# Connection: close, with NO Content-Length -- the body is a sequence of SSE
# events and the closed connection marks the end. The events follow.
def serialize-stream-head :: fun response -> bytes = fun resp {
	let status-line = "HTTP/1.1 " ++ to-string resp.status ++ " " ++ status-text resp.status ++ "\r\n"
	let header-lines = string.join (list.map (dict.entries resp.headers) render-header) ""
	string.to-bytes (status-line ++ header-lines ++ "Connection: close\r\n\r\n")
}

# Drive `events` to its end, writing one SSE event per element, then a terminal
# `done` event. A producer fault is reported as a `fault` event instead. A write
# failure (the client hung up) fails the body, which cancels `for-each` and runs
# the stream's shielded release -- so the producer's resource is freed on every
# terminus (drain, fault, or disconnect). Never fails: the connection closes next
# regardless.
def write-events :: fun net.connection (stream bytes) -> task nothing _ = fun conn events {
	try outcome = task.attempt (stream.for-each events fun chunk {
		try write-all conn (event-next chunk)
		task.ok ()
	})
	when outcome is ok _ {
		try write-all conn event-done
		task.ok ()
	} is err _ {
		try write-all conn event-fault
		task.ok ()
	}
}

# One `next` event: the element's bytes, hex-encoded onto the data line (binary
# safe over the text framing). `\n\n` ends the event.
def event-next :: fun bytes -> bytes = fun b {
	string.to-bytes ("event: next\ndata: " ++ hex.encode b ++ "\n\n")
}

# The clean end-of-stream event.
def event-done :: bytes = string.to-bytes "event: done\n\n"

# The error end-of-stream event (the producer faulted). v1 carries no detail.
def event-fault :: bytes = string.to-bytes "event: fault\n\n"

def render-header :: fun (string, string) -> string = fun pair {
	let (k, v) = pair
	k ++ ": " ++ v ++ "\r\n"
}

def status-text :: fun int -> string = fun code {
	dict.lookup status-names code ?? "OK"
}

def status-names :: dict int string = dict.from-entries [
	(200, "OK"),
	(201, "Created"),
	(204, "No Content"),
	(301, "Moved Permanently"),
	(302, "Found"),
	(400, "Bad Request"),
	(401, "Unauthorized"),
	(403, "Forbidden"),
	(404, "Not Found"),
	(405, "Method Not Allowed"),
	(500, "Internal Server Error"),
]

# --- the client ----------------------------------------------------------

# Makes one HTTP/1.1 request and returns the response. `url` looks like
# "http://127.0.0.1:8080/path" or "https://example.com/path" (the `http://`
# scheme is optional and assumed). An `https` URL is fetched over TLS, with the
# server's certificate verified. Connections are kept alive and reused across
# calls to the same host where the server allows it, so a burst of requests to
# one host doesn't pay a fresh TCP (and TLS) handshake every time. The task
# *fails* with a message if the host can't be reached or the exchange breaks down.
#
#     try resp = http.fetch "https://example.com/"
#         get (dict.empty ()) (string.to-bytes "")
public def fetch :: fun string method (dict string string) bytes -> task response string = fun url verb headers body {
	fetch-with url none verb headers body
}

# Like `fetch`, but also trusts the certificate authority in `ca` (PEM text),
# for an `https` host whose certificate is self-signed or signed by a private
# authority -- the client-side counterpart of `http.serve-tls`. See
# `net.connect-tls-trusting`. (These connections are not pooled.)
#
#     try resp = http.fetch-trusting "https://internal.example/" ca-pem
#         get (dict.empty ()) (string.to-bytes "")
public def fetch-trusting :: fun string string method (dict string string) bytes -> task response string = fun url ca verb headers body {
	fetch-with url (some ca) verb headers body
}

def fetch-with :: fun string (option string) method (dict string string) bytes -> task response string = fun url ca verb headers body {
	let split = split-url url
	let authority = split.0
	let path = split.1
	let secure = url-secure url
	let key = pool-key secure authority
	let req = serialize-request verb path authority headers body true true
	# A pooled connection may have been closed by the server since it went idle;
	# reusing it then fails with no response, so fall back to a fresh connection.
	let idle = when ca is none {
		pool-take key
	} else {
		none
	}
	when idle is some conn {
		try reused = exchange-pooled conn req verb
		when reused is some pair {
			checkin key conn ca pair.1
			task.ok pair.0
		} is none {
			let _ = net.close conn
			fetch-new secure authority key req verb ca
		}
	} is none {
		fetch-new secure authority key req verb ca
	}
}

# Run one request/response over a fresh connection, returning the response and
# either pooling or closing the connection. A `defer` closes the connection if the
# task is cancelled (or fails) before it's been handed to `checkin`.
def fetch-new :: fun bool string string bytes method (option string) -> task response string = fun secure authority key req verb ca {
	try conn = task.flatten (open-conn secure authority ca)
	let settled = ref.new false
	defer close-unless conn settled
	try _ = task.flatten (write-all conn req)
	try pair = read-response-and-reuse conn verb
	checkin key conn ca pair.1
	ref.set settled true
	task.ok pair.0
}

# Run one request/response over a connection taken from the pool. `some (resp,
# reusable)` on success; `none` if the connection was dead (write failed or no
# response arrived) and the caller should retry on a fresh one.
def exchange-pooled :: fun net.connection bytes method -> task (option (response, bool)) string = fun conn req verb {
	try sent = task.attempt (task.flatten (write-all conn req))
	when sent is err _ {
		task.ok none
	} is ok _ {
		try got = task.attempt (read-response-and-reuse conn verb)
		when got is err _ {
			task.ok none
		} is ok pair {
			# A status of 0 means we read no valid status line -- the connection had
			# been closed -- so treat it as stale rather than a real response.
			if pair.0.status == 0 {
				task.ok none
			} else {
				task.ok (some pair)
			}
		}
	}
}

# Return `conn` to the pool when the exchange left it reusable, else close it.
# Custom-CA connections (`ca` present) are never pooled.
def checkin :: fun string net.connection (option string) bool -> nothing = fun key conn ca reusable {
	when ca is none {
		if reusable {
			pool-put key conn
		} else {
			discard-close conn
		}
	} else {
		discard-close conn
	}
}

def close-unless :: fun net.connection (ref bool) -> nothing = fun conn settled {
	if ref.get settled {
		()
	} else {
		discard-close conn
	}
}

def discard-close :: fun net.connection -> nothing = fun conn {
	let _ = net.close conn
	()
}

# Whether `url` calls for a secure (TLS) transport -- i.e. an `https` scheme.
def url-secure :: fun string -> bool = fun url {
	string.starts-with url "https://"
}

# Open a connection to `authority` (a `host:port`): TLS when `secure`, trusting an
# extra CA when one is given, else plain TCP.
def open-conn :: fun bool string (option string) -> task (result connection string) _ = fun secure authority ca {
	if secure {
		when ca is some pem {
			task.attempt (net.connect-tls-trusting authority pem)
		} is none {
			task.attempt (net.connect-tls authority)
		}
	} else {
		task.attempt (net.connect authority)
	}
}

# --- the connection pool -------------------------------------------------

# Idle keep-alive connections, keyed by transport+authority (e.g.
# "s:example.com:443"). A connection is checked out for exactly one exchange and
# returned only if that exchange left it reusable, so a pooled connection is never
# shared between two in-flight requests. `pool-take`/`pool-put` don't suspend, so
# they run atomically against other fibers (the scheduler only switches at `try`).
def conn-pool :: ref (dict string (list net.connection)) = ref.new (dict.empty ())

# Most idle connections kept per host; beyond this, returned connections are closed.
def pool-cap :: int = 8

def pool-key :: fun bool string -> string = fun secure authority {
	if secure {
		"s:"
	} else {
		"p:"
	} ++ authority
}

def pool-take :: fun string -> option net.connection = fun key {
	let table = ref.get conn-pool
	let idle = dict.lookup table key ?? []
	when list.head idle is some conn {
		ref.set conn-pool (dict.insert table key (list.drop idle 1))
		some conn
	} is none {
		none
	}
}

def pool-put :: fun string net.connection -> nothing = fun key conn {
	let table = ref.get conn-pool
	let idle = dict.lookup table key ?? []
	if list.length idle >= pool-cap {
		discard-close conn
	} else {
		ref.set conn-pool (dict.insert table key [conn, ...idle])
	}
}

# Splits "http://host:port/a/b?x" into `("host:port", "/a/b?x")`. The scheme
# prefix (`http://` or `https://`) is stripped if present, a missing path
# defaults to "/", and a missing port defaults to 80 -- or 443 under `https` --
# since `net.connect`/`net.connect-tls` require an explicit `host:port`.
def split-url :: fun string -> (string, string) = fun url {
	let secure = url-secure url
	let after-scheme = if secure {
		string.drop url 8
	} else if string.starts-with url "http://" {
		string.drop url 7
	} else {
		url
	}
	let segs = string.split after-scheme "/"
	let raw-authority = list.head segs ?? after-scheme
	let default-port = if secure {
		":443"
	} else {
		":80"
	}
	let authority = if string.contains raw-authority ":" {
		raw-authority
	} else {
		raw-authority ++ default-port
	}
	let path = "/" ++ string.join (list.drop segs 1) "/"
	(authority, path)
}

# Render a request as HTTP/1.1 bytes: request line, Host, the computed
# Content-Length, then body. With `keep-alive`, no `Connection` header is sent
# (HTTP/1.1 keeps the connection open by default); otherwise `Connection: close`.
# With `accept-compressed`, an `Accept-Encoding: gzip, br` header invites the
# server to compress its response (which the client transparently decodes).
def serialize-request :: fun method string string (dict string string) bytes bool bool -> bytes = fun verb path authority headers body keep-alive accept-compressed {
	let request-line = method-name verb ++ " " ++ path ++ " HTTP/1.1\r\n"
	let host-line = "Host: " ++ authority ++ "\r\n"
	let custom-lines = string.join (list.map (dict.entries headers) render-header) ""
	let length-line = "Content-Length: " ++ to-string (bytes.length body) ++ "\r\n"
	let conn-line = if keep-alive {
		""
	} else {
		"Connection: close\r\n"
	}
	let accept-line = if accept-compressed {
		"Accept-Encoding: gzip, br\r\n"
	} else {
		""
	}
	let head = request-line ++ host-line ++ custom-lines ++ length-line ++ conn-line ++ accept-line ++ "\r\n"
	bytes.concat (string.to-bytes head) body
}

def method-name :: fun method -> string = fun m {
	when m is method.get {
		"GET"
	} is method.post {
		"POST"
	} is method.put {
		"PUT"
	} is method.delete {
		"DELETE"
	} is method.patch {
		"PATCH"
	} is method.head {
		"HEAD"
	} is method.options {
		"OPTIONS"
	} is method.other name {
		name
	}
}

# Read and parse one response off `conn`, returning it together with whether the
# connection can be reused (kept alive). The body is framed precisely -- by
# `Transfer-Encoding: chunked`, by `Content-Length`, by the no-body rule for HEAD
# / 1xx / 204 / 304, or (last resort) by the connection closing -- so that with
# keep-alive we stop exactly at the end of this response and leave the socket
# positioned for the next one. A close-delimited body spends the connection, so it
# reports `false`; otherwise reuse rides on the response's `Connection` header.
def read-response-and-reuse :: fun net.connection method -> task (response, bool) string = fun conn verb {
	try raw = task.flatten (read-until-headers conn (string.to-bytes ""))
	let parsed = parse-response-head raw
	# Read the raw (still-encoded) body, framed, then -- once the connection is past
	# it and reuse is decided -- undo any `Content-Encoding` (gzip / brotli).
	try framed = read-framed-body conn verb parsed
	try body = task.lift (decode-body parsed.headers framed.0)
	task.ok (mk-response parsed body, framed.1)
}

# Read the response body exactly, and report whether the connection stays reusable.
# Framing: no body for HEAD / 1xx / 204 / 304; else chunked, else Content-Length,
# else (last resort) read to connection close -- which spends the connection.
# (Untyped so `parsed` stays row-polymorphic over the parse record's exact shape.)
def read-framed-body = fun conn verb parsed {
	if response-bodyless verb parsed.status {
		task.ok (string.to-bytes "", true)
	} else if parsed.chunked {
		try body = task.flatten (read-chunked conn parsed.body-start (string.to-bytes ""))
		task.ok (body, true)
	} else if parsed.has-length {
		try body = task.flatten (read-body conn parsed.body-start parsed.content-length)
		task.ok (body, true)
	} else {
		try body = task.flatten (read-to-close conn parsed.body-start)
		task.ok (body, false)
	}
}

# Undo the response's `Content-Encoding`, if any. An empty body is left alone (a
# bodyless response carries no codec stream to decode).
def decode-body :: fun (dict string string) bytes -> result bytes string = fun headers body {
	if bytes.is-empty body {
		ok body
	} else {
		when dict.lookup headers "content-encoding" is some enc {
			decode-encoding (string.to-lower (string.trim enc)) body
		} is none {
			ok body
		}
	}
}

def decode-encoding :: fun string bytes -> result bytes string = fun enc body {
	if enc == "gzip" or enc == "x-gzip" {
		compress.gunzip body
	} else if enc == "br" {
		compress.unbrotli body
	} else if enc == "" or enc == "identity" {
		ok body
	} else {
		# Includes multi-codec stacks like "gzip, br", which v1 doesn't unwind.
		err ("http.fetch: unsupported content-encoding: " ++ enc)
	}
}

# Build a `response` from a parsed head + body (row-polymorphic over the parse
# record's exact shape, so it works for both the framing reader and the streaming
# client's lighter head).
def mk-response = fun parsed body {
	{status: parsed.status, headers: parsed.headers, body, stream-body: none, hijack: none}
}

# Whether a response to `verb` with this status carries no body, per HTTP: any
# response to HEAD, and every 1xx / 204 / 304 -- where a Content-Length, if
# present, describes the resource but is not actually sent on the wire.
def response-bodyless :: fun method int -> bool = fun verb status {
	when verb is method.head {
		true
	} else {
		status == 204 or status == 304 or status >= 100 and status < 200
	}
}

# Whether the server agreed to keep the connection open: true unless it sent
# `Connection: close` (HTTP/1.1 keeps connections alive by default).
def response-keep-alive :: fun (dict string string) -> bool = fun headers {
	when dict.lookup headers "connection" is some v {
		if string.contains (string.to-lower v) "close" {
			false
		} else {
			true
		}
	} is none {
		true
	}
}

# Read a close-delimited body: everything until the peer hangs up.
def read-to-close :: fun net.connection bytes -> task (result bytes string) _ = fun conn acc {
	try r = task.attempt (net.read conn 4096)
	when r is ok chunk {
		if bytes.is-empty chunk {
			task.ok (ok acc)
		} else {
			read-to-close conn (bytes.concat acc chunk)
		}
	} is err e {
		task.ok (err e)
	}
}

# --- chunked transfer decoding ------------------------------------------

def crlf :: bytes = string.to-bytes "\r\n"

# Decode a `Transfer-Encoding: chunked` body. `buf` is the unconsumed bytes (it
# starts at a chunk-size line); `acc` is the body decoded so far. Each chunk is
# `<hex-size>[;ext]\r\n<size bytes>\r\n`; a zero size ends the body. We read more
# from `conn` whenever the buffer doesn't yet hold a full size line, or a full
# chunk plus its trailing CRLF, and on the terminator we drain through the closing
# blank line so the connection is left clean for reuse.
def read-chunked :: fun net.connection bytes bytes -> task (result bytes string) _ = fun conn buf acc {
	when index-of-crlf buf 0 is some idx {
		let size = hex-prefix-value buf
		if size == 0 {
			# Last chunk: make sure the closing "\r\n\r\n" (after any trailers) has been
			# read off the socket before we hand the connection back.
			if bytes.contains (bytes.slice buf idx (bytes.length buf)) crlf2 {
				task.ok (ok acc)
			} else {
				try buf2 = task.flatten (chunked-pull conn buf)
				read-chunked conn buf2 acc
			}
		} else {
			let data-start = idx + 2
			let data-end = data-start + size
			let need = data-end + 2
			if bytes.length buf >= need {
				let chunk = bytes.slice buf data-start data-end
				read-chunked conn (bytes.slice buf need (bytes.length buf)) (bytes.concat acc chunk)
			} else {
				try buf2 = task.flatten (chunked-pull conn buf)
				read-chunked conn buf2 acc
			}
		}
	} is none {
		try buf2 = task.flatten (chunked-pull conn buf)
		read-chunked conn buf2 acc
	}
}

# Read one more block into `buf`; fail if the peer closed before the body ended.
def chunked-pull :: fun net.connection bytes -> task (result bytes string) _ = fun conn buf {
	try r = task.attempt (net.read conn 4096)
	when r is ok chunk {
		if bytes.is-empty chunk {
			task.ok (err "http.fetch: connection closed mid chunked body")
		} else {
			task.ok (ok (bytes.concat buf chunk))
		}
	} is err e {
		task.ok (err e)
	}
}

# Index of the first "\r\n" at or after `i`, or none. The size line is short, so
# starting each search at the front of the unconsumed buffer keeps this cheap.
def index-of-crlf :: fun bytes int -> option int = fun b i {
	if i + 1 >= bytes.length b {
		none
	} else if bytes.get b i == 13 and bytes.get b (i + 1) == 10 {
		some i
	} else {
		index-of-crlf b (i + 1)
	}
}

# Value of the hex digits at the front of `b` (a chunk-size line), stopping at the
# first non-hex byte (`;` extensions, or the CR).
def hex-prefix-value :: fun bytes -> int = fun b {
	hex-fold b 0 0
}

def hex-fold :: fun bytes int int -> int = fun b i acc {
	if i >= bytes.length b {
		acc
	} else {
		when hex-digit-value (bytes.get b i) is some d {
			hex-fold b (i + 1) (acc * 16 + d)
		} is none {
			acc
		}
	}
}

def hex-digit-value :: fun int -> option int = fun c {
	if c >= 48 and c <= 57 {
		some (c - 48)
	} else if c >= 97 and c <= 102 {
		some (c - 87)
	} else if c >= 65 and c <= 70 {
		some (c - 55)
	} else {
		none
	}
}

# Split the raw bytes at the header/body boundary and parse the status line +
# headers. The dual of `parse-head`, for the client side.
def parse-response-head :: fun bytes -> {
	status :: int,
	headers :: dict string string,
	content-length :: int,
	has-length :: bool,
	chunked :: bool,
	body-start :: bytes,
} = fun raw {
	let parts = bytes.split raw crlf2
	let head = list.head parts ?? string.to-bytes ""
	let body-start = bytes.join (list.drop parts 1) crlf2
	let header-str = bytes.to-string head ?? ""
	let lines = string.split header-str "\r\n"
	let status-line = list.head lines ?? ""
	let sl = string.split status-line " "
	let status = string.to-int (nth sl 1 "0") ?? 0
	let headers = dict.from-entries (list.fold (list.drop lines 1) [] parse-header)
	let clen = when dict.lookup headers "content-length" is some v {
		string.to-int v ?? 0
	} is none {
		0
	}
	let chunked = when dict.lookup headers "transfer-encoding" is some te {
		string.contains (string.to-lower te) "chunked"
	} is none {
		false
	}
	{
		status,
		headers,
		content-length: clen,
		has-length: dict.contains-key headers "content-length",
		chunked,
		body-start,
	}
}

# --- the streaming client ------------------------------------------------

# Opens a streaming request and reads the reply as a `stream bytes`: one element
# per server SSE event (the dual of `stream-response`). `open` connects, sends
# the request, and consumes the status line + headers; each `next` reads until a
# whole `\n\n`-framed event is buffered and yields its payload (`done`/connection
# close ends the stream, `fault` fails the task); `close` shuts the connection.
# Because it's a `from-resource` stream, the connection is released on every
# terminus -- drained, faulted, or cancelled (the consumer stopping early).
#
#     try _ = stream.for-each
#         (http.fetch-stream "http://127.0.0.1:8080/_rpc/api.ticks" post hdrs body)
#         (fun frame { io.print (hex.encode frame); task.ok () })
public def fetch-stream :: fun string method (dict string string) bytes -> stream bytes = fun url verb headers body {
	stream.from-resource {
		open: fun {
			let split = split-url url
			try c = open-conn (url-secure url) split.0 none
			when c is ok conn {
				try write-all conn (serialize-request verb split.1 split.0 headers body false false)
				try raw-r = read-until-headers conn (string.to-bytes "")
				when raw-r is ok raw {
					let parsed = parse-response-head raw
					if parsed.status == 200 {
						task.ok (conn, ref.new parsed.body-start)
					} else {
						net.close conn
						task.err ("http.fetch-stream: status " ++ to-string parsed.status)
					}
				} is err e {
					net.close conn
					task.err e
				}
			} is err e {
				task.err e
			}
		},
		next: fun res {
			let (conn, buf) = res
			read-event conn buf
		},
		close: fun res {
			let (conn, _buf) = res
			net.close conn
			task.ok ()
		},
	}
}

# The SSE event separator: a blank line.
def nlnl :: bytes = string.to-bytes "\n\n"

# Pull one event out of `buf` (the leftover bytes between reads), reading more
# from `conn` until a whole event is buffered. `none` once the stream ends (a
# `done` event or the peer closing); a task failure on a `fault` event or a read
# error. Decoded payload bytes on a `next` event.
def read-event :: fun net.connection (ref bytes) -> task (option bytes) _ = fun conn buf {
	when split-event (ref.get buf) is some pair {
		ref.set buf pair.1
		parse-event pair.0
	} is none {
		try r = task.attempt (net.read conn 4096)
		when r is ok chunk {
			if bytes.is-empty chunk {
				task.ok none
			} else {
				ref.set buf (bytes.concat (ref.get buf) chunk)
				read-event conn buf
			}
		} is err e {
			task.err e
		}
	}
}

# Split off the first `\n\n`-terminated event, returning `(event, rest)`, or
# `none` if no complete event is buffered yet.
def split-event :: fun bytes -> option (bytes, bytes) = fun buf {
	if bytes.contains buf nlnl {
		let parts = bytes.split buf nlnl
		let ev = list.head parts ?? string.to-bytes ""
		let rest = bytes.join (list.drop parts 1) nlnl
		some (ev, rest)
	} else {
		none
	}
}

# Interpret one event's text: `next` yields its hex-decoded payload, `done` (and
# anything unrecognised) ends the stream, `fault` fails the task.
def parse-event :: fun bytes -> task (option bytes) _ = fun ev {
	let lines = string.split (bytes.to-string ev ?? "") "\n"
	let kind = line-after lines "event: "
	if kind == "next" {
		when hex.decode (line-after lines "data: ") is ok b {
			task.ok (some b)
		} is err _ {
			task.err "http.fetch-stream: malformed frame"
		}
	} else if kind == "fault" {
		task.err "http.fetch-stream: stream faulted"
	} else {
		task.ok none
	}
}

# The text after the first line starting with `prefix`, or `""` if none.
def line-after :: fun (list string) string -> string = fun lines prefix {
	list.fold lines "" fun acc line {
		if string.starts-with line prefix {
			string.drop line (string.length prefix)
		} else {
			acc
		}
	}
}
