use std/assert
use std/dict
use std/json
use std/list
use std/test

def tests :: test.suite = [
	test.case "parse null" fun {
		# --- parse: primitives ---

		when json.parse "null" is ok v {
			assert.is-true (json.is-null v)
		} is err _e {
			assert.fail "parsing \"null\" should succeed"
		}
	},
	test.case "parse true" fun {
		when json.parse "true" is ok v {
			when json.get-bool v is some b {
				assert.is-true b
			} is none {
				assert.fail "parsed \"true\" should be a bool"
			}
		} is err _e {
			assert.fail "parsing \"true\" should succeed"
		}
	},
	test.case "parse false" fun {
		when json.parse "false" is ok v {
			when json.get-bool v is some b {
				assert.is-false b
			} is none {
				assert.fail "parsed \"false\" should be a bool"
			}
		} is err _e {
			assert.fail "parsing \"false\" should succeed"
		}
	},
	test.case "parse int" fun {
		when json.parse "42" is ok v {
			when json.get-int v is some n {
				assert.equals n 42
			} is none {
				assert.fail "parsed \"42\" should be an int"
			}
		} is err _e {
			assert.fail "parsing \"42\" should succeed"
		}
	},
	test.case "parse negative int" fun {
		when json.parse "-7" is ok v {
			when json.get-int v is some n {
				assert.equals n (-7)
			} is none {
				assert.fail "parsed \"-7\" should be an int"
			}
		} is err _e {
			assert.fail "parsing \"-7\" should succeed"
		}
	},
	test.case "parse float" fun {
		when json.parse "3.14" is ok v {
			when json.get-float v is some x {
				assert.equals x 3.14
			} is none {
				assert.fail "parsed \"3.14\" should be a float"
			}
		} is err _e {
			assert.fail "parsing \"3.14\" should succeed"
		}
	},
	test.case "parse string" fun {
		when json.parse "\"hi\"" is ok v {
			when json.get-string v is some s {
				assert.equals s "hi"
			} is none {
				assert.fail "parsed \"hi\" should be a string"
			}
		} is err _e {
			assert.fail "parsing a string literal should succeed"
		}
	},
	test.case "parse empty array" fun {
		# --- parse: compound ---

		when json.parse "[]" is ok v {
			when json.get-array v is some xs {
				assert.equals (list.length xs) 0
			} is none {
				assert.fail "parsed \"[]\" should be an array"
			}
		} is err _e {
			assert.fail "parsing \"[]\" should succeed"
		}
	},
	test.case "parse array of ints" fun {
		when json.parse "[1, 2, 3]" is ok v {
			when json.get-array v is some xs {
				assert.equals (list.length xs) 3
			} is none {
				assert.fail "parsed \"[1, 2, 3]\" should be an array"
			}
		} is err _e {
			assert.fail "parsing \"[1, 2, 3]\" should succeed"
		}
	},
	test.case "parse empty object" fun {
		when json.parse "{}" is ok v {
			when json.get-object v is some o {
				assert.equals (dict.size o) 0
			} is none {
				assert.fail "parsed \"{}\" should be an object"
			}
		} is err _e {
			assert.fail "parsing \"{}\" should succeed"
		}
	},
	test.case "parse error on malformed input" fun {
		# --- parse: errors ---

		when json.parse "{bad json" is ok _v {
			assert.fail "parsing malformed input should fail"
		} is err _e {
			assert.is-true true
		}
	},
	test.case "parse error carries line and col" fun {
		when json.parse "{bad" is ok _v {
			assert.fail "parsing malformed input should fail"
		} is err e {
			assert.all [assert.equals e.line 1, assert.equals e.col 2]
		}
	},
	test.case "parse error on trailing garbage" fun {
		when json.parse "42 extra" is ok _v {
			assert.fail "parsing trailing garbage should fail"
		} is err _e {
			assert.is-true true
		}
	},
	test.case "stringify null" fun {
		# --- stringify ---

		assert.equals (json.stringify json.value.null) "null"
	},
	test.case "stringify true" fun { assert.equals (json.stringify (json.value.bool true)) "true" },
	test.case "stringify int" fun { assert.equals (json.stringify (json.value.int 42)) "42" },
	test.case "stringify string" fun {
		assert.equals (json.stringify (json.value.string "hi")) "\"hi\""
	},
	test.case "stringify round-trip via parse" fun {
		when json.parse "[1,2,3]" is ok v {
			assert.equals (json.stringify v) "[1,2,3]"
		} is err _e {
			assert.fail "parsing \"[1,2,3]\" should succeed"
		}
	},
	test.case "is-null on null variant" fun {
		# --- is-null ---

		assert.is-true (json.is-null json.value.null)
	},
	test.case "is-null on non-null" fun {
		assert.all [
			assert.is-false (json.is-null (json.value.int 0)),
			assert.is-false (json.is-null (json.value.bool false)),
			assert.is-false (json.is-null (json.value.string "")),
		]
	},
	test.case "get-field returns some on a hit" fun {
		# --- get-field ---

		when json.parse "{\"a\": 1}" is ok v {
			when json.get-field v "a" is some inner {
				when json.get-int inner is some n {
					assert.equals n 1
				} is none {
					assert.fail "field \"a\" should be an int"
				}
			} is none {
				assert.fail "field \"a\" should be present"
			}
		} is err _e {
			assert.fail "parsing an object should succeed"
		}
	},
	test.case "get-field returns none for missing key" fun {
		when json.parse "{\"a\": 1}" is ok v {
			when json.get-field v "missing" is some _inner {
				assert.fail "missing key should not be found"
			} is none {
				assert.is-true true
			}
		} is err _e {
			assert.fail "parsing an object should succeed"
		}
	},
	test.case "get-field on non-object returns none" fun {
		when json.get-field (json.value.int 5) "a" is some _inner {
			assert.fail "get-field on a non-object should be none"
		} is none {
			assert.is-true true
		}
	},
	test.case "get-int on a string is none" fun {
		# --- get-* type filters ---

		when json.get-int (json.value.string "x") is some _n {
			assert.fail "get-int on a string should be none"
		} is none {
			assert.is-true true
		}
	},
	test.case "get-float on an int is none" fun {
		when json.get-float (json.value.int 42) is some _x {
			assert.fail "get-float on an int should be none"
		} is none {
			assert.is-true true
		}
	},
	test.case "get-number promotes int to float" fun {
		when json.get-number (json.value.int 42) is some x {
			assert.equals x 42.0
		} is none {
			assert.fail "get-number on an int should be some"
		}
	},
	test.case "get-number passes float through" fun {
		when json.get-number (json.value.float 3.5) is some x {
			assert.equals x 3.5
		} is none {
			assert.fail "get-number on a float should be some"
		}
	},
	test.case "get-number on a string is none" fun {
		when json.get-number (json.value.string "x") is some _x {
			assert.fail "get-number on a string should be none"
		} is none {
			assert.is-true true
		}
	},
	test.case "get-bool on a non-bool is none" fun {
		when json.get-bool (json.value.int 1) is some _b {
			assert.fail "get-bool on a non-bool should be none"
		} is none {
			assert.is-true true
		}
	},
	test.case "get-string on a non-string is none" fun {
		when json.get-string (json.value.int 1) is some _s {
			assert.fail "get-string on a non-string should be none"
		} is none {
			assert.is-true true
		}
	},
	test.case "get-array on a non-array is none" fun {
		when json.get-array (json.value.int 1) is some _xs {
			assert.fail "get-array on a non-array should be none"
		} is none {
			assert.is-true true
		}
	},
	test.case "get-object on a non-object is none" fun {
		when json.get-object (json.value.int 1) is some _o {
			assert.fail "get-object on a non-object should be none"
		} is none {
			assert.is-true true
		}
	},
]
