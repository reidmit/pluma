# `result.expect` on an `err` aborts the whole program: a `result.expect:`-labelled
# message, then the underlying error, go to stderr and the program exits nonzero.
# `after` never prints.
use std/string

def main = fun {
	print "before"
	print (string.to-int "abc" |> result.expect "parsing the count")
	print "after"
}
