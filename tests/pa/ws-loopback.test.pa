use std/assert
use std/bytes
use std/string
use std/task
use std/test
use std/sys/http
use std/sys/net
use std/sys/ws

# WebSocket loopback: an HTTP server with a `/socket` route that upgrades to an
# echo handler, and a `ws` client that connects, sends a text then a binary
# message, and checks both echoes round-trip through the framing on both ends
# (client masks, server doesn't). One module / isolate, like the other net tests.

# Echo every message back until the peer closes.
def echo-loop :: fun ws.conn -> task nothing string = fun sock {
	try msg = ws.receive sock
	when msg is some m {
		try _ = ws.send sock m
		echo-loop sock
	} is none {
		task.ok ()
	}
}

def handler :: fun http.request -> task http.response = fun req {
	if req.path == "/socket" {
		task.ok (ws.upgrade req echo-loop)
	} else {
		task.ok (http.not-found ())
	}
}

def run :: fun nothing -> task (string, string) string = fun {
	when net.listen "127.0.0.1:0" is ok server {
		when net.local-addr server is ok addr {
			scope as s {
				s.spawn (http.serve-on server handler)
				try sock = ws.connect ("ws://" ++ addr ++ "/socket")
				try _ = ws.send-text sock "hello websocket"
				try first = ws.receive sock
				try _ = ws.send-binary sock (string.to-bytes "binary-payload")
				try second = ws.receive sock
				try _ = ws.close sock
				s.cancel ()
				task.ok (describe first, describe second)
			}
		} is err e {
			task.err ("addr: " ++ e)
		}
	} is err e {
		task.err ("listen: " ++ e)
	}
}

# Render a received message for a stable assertion.
def describe :: fun (option ws.message) -> string = fun m {
	when m is some msg {
		when msg is ws.message.text t {
			"text:" ++ t
		} is ws.message.binary b {
			"binary:" ++ (bytes.to-string b ?? "<bad>")
		}
	} is none {
		"closed"
	}
}

def tests :: test.suite = [
	test.case "echo round-trips text and binary" fun {
		try settled = task.attempt (run ())
		when settled is ok pair {
			assert.all [
				assert.equals pair.0 "text:hello websocket",
				assert.equals pair.1 "binary:binary-payload",
			]
		} is err e {
			assert.equals ("error: " ++ e) "ok"
		}
	},
]
