use std/assert
use std/task
use std/test
use std/sys/io

# Direct calls to `option.and-then` (the module's `and-then` function on the
# auto-imported `std/option` native module). Chains over option values:
# `some v` invokes the continuation; `none` short-circuits.

def double-if-positive = fun n {
	if n > 0 {
		some (n * 2)
	} else {
		none
	}
}

def run = fun {
	# some -> some
	let a = option.and-then (some 5) double-if-positive
	when a is some v {
		print v
	} is none {
		print (0 - 1)
	}

	# some -> none (short-circuits at the continuation)
	let b = option.and-then (some (0 - 3)) double-if-positive
	when b is some v {
		print v
	} is none {
		print (0 - 1)
	}

	# none -> none (short-circuits on the input)
	let c = option.and-then none double-if-positive
	when c is some v {
		print v
	} is none {
		print (0 - 1)
	}
}

def tests :: test.suite = [
	test.case "option-and-then-direct" fun {
		try cap = io.capture fun {
			run ()
			task.ok ()
		}
		assert.matches cap.out """
			10
			-1
			-1

			"""
	},
]
