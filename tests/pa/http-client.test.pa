use std/assert
use std/bytes
use std/compress
use std/dict
use std/string
use std/task
use std/test
use std/sys/http
use std/sys/net

# Client-side HTTP behaviour that needs a server speaking a specific dialect, so
# these stand up raw `net` servers (not `http.serve`) on loopback and drive the
# real `http.fetch` against them: (1) a chunked-transfer response is decoded, and
# (2) a keep-alive connection is actually reused across two fetches.

def crlf2 :: bytes = string.to-bytes "\r\n\r\n"

# Read off a connection until the blank line ending the request headers (the test
# clients send no body), or the peer closes.
def read-headers :: fun net.connection bytes -> task (result bytes string) = fun conn acc {
	if bytes.contains acc crlf2 {
		task.ok (ok acc)
	} else {
		try r = net.read conn 4096
		when r is ok chunk {
			if bytes.is-empty chunk {
				task.ok (ok acc)
			} else {
				read-headers conn (bytes.concat acc chunk)
			}
		} is err e {
			task.ok (err e)
		}
	}
}

def write-bytes :: fun net.connection bytes -> task (result int string) = fun conn data {
	if bytes.is-empty data {
		task.ok (ok 0)
	} else {
		try w = net.write conn data
		when w is ok n {
			if n >= bytes.length data {
				task.ok (ok n)
			} else {
				write-bytes conn (bytes.slice data n (bytes.length data))
			}
		} is err e {
			task.ok (err e)
		}
	}
}

def close-it :: fun net.connection -> nothing = fun conn {
	let _ = net.close conn
	()
}

# --- chunked transfer decoding -------------------------------------------

# Serve one hand-rolled chunked response: "Hello" + " World" as two chunks.
def serve-chunked :: fun net.listener -> task nothing = fun server {
	try conn = task.unwrap (net.accept server)
	try _req = task.unwrap (read-headers conn (string.to-bytes ""))
	let resp = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5\r\nHello\r\n6\r\n World\r\n0\r\n\r\n"
	try _sent = task.unwrap (write-bytes conn (string.to-bytes resp))
	close-it conn
	task.ok ()
}

def run-chunked :: fun nothing -> task string string = fun {
	when net.listen "127.0.0.1:0" is ok server {
		when net.local-addr server is ok addr {
			scope as s {
				s.spawn (serve-chunked server)
				try resp = http.fetch ("http://" ++ addr ++ "/x") http.method.get (dict.empty ()) (string.to-bytes "")
				s.cancel ()
				task.ok (bytes.to-string resp.body ?? "<non-utf8>")
			}
		} is err e {
			task.err ("addr: " ++ e)
		}
	} is err e {
		task.err ("listen: " ++ e)
	}
}

# --- keep-alive connection reuse -----------------------------------------

# A server that accepts connections concurrently, counting each one, and serves
# every request on a connection in turn (HTTP/1.1 keep-alive). Because it accepts
# concurrently it never wedges -- so the test can prove reuse by counting: N
# sequential fetches that reuse one connection produce far fewer accepts than N.
def count-accepts :: fun net.listener (ref int) -> task nothing = fun server counter {
	manual scope as s {
		s.spawn (accept-conn server counter)
		drain-accepts s server counter
	}
}

# Settles to `some conn` for a freshly accepted (and counted) connection, `none`
# when a served connection finishes -- one homogeneous type for the manual scope.
def accept-conn :: fun net.listener (ref int) -> task (option net.connection) = fun server counter {
	try c = net.accept server
	when c is ok conn {
		ref.set counter (ref.get counter + 1)
		task.ok (some conn)
	} is err _ {
		task.ok none
	}
}

def serve-conn :: fun net.connection -> task (option net.connection) = fun conn {
	try _ = respond-loop conn
	task.ok none
}

def respond-loop :: fun net.connection -> task nothing = fun conn {
	try req = task.unwrap (read-headers conn (string.to-bytes ""))
	if bytes.is-empty req {
		close-it conn
		task.ok ()
	} else {
		try _sent = task.unwrap (write-bytes conn (string.to-bytes "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nok!"))
		respond-loop conn
	}
}

# Drain the accept scope: an accepted connection spawns its keep-alive handler and
# re-arms the acceptor; a finished handler just continues; `none` (listener closed
# on cancel) ends the loop.
def drain-accepts :: fun (manual-scope-handle (option net.connection)) net.listener (ref int) -> task nothing = fun s server counter {
	try got = s.next ()
	when got is none {
		task.ok ()
	} is some outcome {
		when outcome is ok maybe {
			when maybe is some conn {
				s.spawn (serve-conn conn)
				s.spawn (accept-conn server counter)
				drain-accepts s server counter
			} is none {
				drain-accepts s server counter
			}
		} is err _ {
			drain-accepts s server counter
		}
	}
}

# Fetch `base` `n` times in turn, counting the 200s. A reused connection makes the
# fetches fast; the timeout is only a safety net against a genuine reuse break.
def fetch-n :: fun string int int -> task int string = fun base n oks {
	if n <= 0 {
		task.ok oks
	} else {
		try settled = task.attempt (task.with-timeout 5s (http.fetch (base ++ "/r") http.method.get (dict.empty ()) (string.to-bytes "")))
		let got = when settled is ok r {
			if r.status == 200 {
				1
			} else {
				0
			}
		} is err _ {
			0
		}
		fetch-n base (n - 1) (oks + got)
	}
}

# Run 4 sequential fetches against the counting server and report (accepts, oks).
def run-reuse :: fun nothing -> task (int, int) string = fun {
	when net.listen "127.0.0.1:0" is ok server {
		when net.local-addr server is ok addr {
			let counter = ref.new 0
			scope as s {
				s.spawn (count-accepts server counter)
				try oks = fetch-n ("http://" ++ addr) 4 0
				s.cancel ()
				task.ok (ref.get counter, oks)
			}
		} is err e {
			task.err ("addr: " ++ e)
		}
	} is err e {
		task.err ("listen: " ++ e)
	}
}

# --- content-encoding (gzip) decode --------------------------------------

# Serve a gzip-compressed body, labelled `Content-Encoding: gzip`. The payload is
# produced by `compress.gzip`, so the client must run the codec to recover it.
def serve-gzip :: fun net.listener -> task nothing = fun server {
	try conn = task.unwrap (net.accept server)
	try _req = task.unwrap (read-headers conn (string.to-bytes ""))
	let payload = compress.gzip (string.to-bytes "compressed hello")
	let head = "HTTP/1.1 200 OK\r\nContent-Encoding: gzip\r\nContent-Length: " ++ to-string (bytes.length payload) ++ "\r\nConnection: close\r\n\r\n"
	try _sent = task.unwrap (write-bytes conn (bytes.concat (string.to-bytes head) payload))
	close-it conn
	task.ok ()
}

def run-gzip :: fun nothing -> task string string = fun {
	when net.listen "127.0.0.1:0" is ok server {
		when net.local-addr server is ok addr {
			scope as s {
				s.spawn (serve-gzip server)
				try resp = http.fetch ("http://" ++ addr ++ "/g") http.method.get (dict.empty ()) (string.to-bytes "")
				s.cancel ()
				task.ok (bytes.to-string resp.body ?? "<non-utf8>")
			}
		} is err e {
			task.err ("addr: " ++ e)
		}
	} is err e {
		task.err ("listen: " ++ e)
	}
}

def tests :: test.suite = [
	test.case "codec round-trips" fun {
		let original = string.to-bytes "the quick brown fox, the quick brown fox, the quick brown fox"
		try gz = task.lift (compress.gunzip (compress.gzip original))
		try br = task.lift (compress.unbrotli (compress.brotli original))
		assert.all [
			assert.equals (bytes.to-string gz ?? "g") (bytes.to-string original ?? "o"),
			assert.equals (bytes.to-string br ?? "b") (bytes.to-string original ?? "o"),
			assert.is-err (compress.gunzip (string.to-bytes "not gzip at all")),
		]
	},
	test.case "gzip response decoded" fun {
		try settled = task.attempt (run-gzip ())
		when settled is ok body {
			assert.equals body "compressed hello"
		} is err e {
			assert.equals ("error: " ++ e) "compressed hello"
		}
	},
	test.case "chunked response decoded" fun {
		try settled = task.attempt (run-chunked ())
		when settled is ok body {
			assert.equals body "Hello World"
		} is err e {
			assert.equals ("error: " ++ e) "Hello World"
		}
	},
	test.case "keep-alive connection reused" fun {
		try settled = task.attempt (run-reuse ())
		when settled is ok pair {
			# pair = (accepts, oks). All 4 fetches succeed, and they cost fewer than
			# 4 connections -- proof the client reused kept-alive connections (with
			# pooling working it's a single accept).
			assert.all [
				assert.equals pair.1 4,
				assert.is-true (pair.0 >= 1 and pair.0 < 4),
			]
		} is err e {
			assert.equals ("error: " ++ e) "(reused)"
		}
	},
]
